# Optional local JSON store path (relative to the project root).
LOCAL_STORE_PATH=data/store.json

# Optional MongoDB Atlas connection. When set, MongoDB is used instead of the local JSON file.
# Keep real credentials in .env.local; never commit them.
MONGODB_URI=
MONGODB_DB=marketplace_intelligence

# Optional server-side DeepSeek API key for stock and trend advice.
# Use a rotated key in .env.local; never use a NEXT_PUBLIC_ variable.
DEEPSEEK_API_KEY=
